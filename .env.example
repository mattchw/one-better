# Copy to .env.local AND .env (Compose reads .env); replace placeholders.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD
DATABASE_URL=postgresql://execution:REPLACE_WITH_RANDOM_LOCAL_DATABASE_PASSWORD@127.0.0.1:55432/execution
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://127.0.0.1:3100
# Separate Google Web OAuth client for One Better identity/login only.
# Exact authorised redirect URI: http://127.0.0.1:3100/api/auth/callback/google
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
LOCAL_USER_EMAIL=local@example.test
# Optional AI coaching; no calls occur until Get coaching / Refresh coaching.
# Choose openai or anthropic and configure that provider's key AND exact model ID.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LOCAL_USER_NAME=Local Engineer
LOCAL_USER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
LOCAL_USER_TIMEZONE=Europe/London

# Optional Calendar connection; manual planning needs none of these.
# Enable Calendar API; create a Web OAuth client and register this EXACT URI.
GOOGLE_CALENDAR_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:3100/api/calendar/callback
# JSON key ring of random 32-byte base64 AES keys, kept outside DB/source control.
# Example shape only: {"local-v1":"YOUR_RANDOM_32_BYTE_BASE64_KEY"}
CALENDAR_ENCRYPTION_KEYS=
CALENDAR_ENCRYPTION_KEY_ID=local-v1

# Optional ChatGPT plan connection (R5E): no OpenAI API key/client secret needed.
# Settings → Integrations → ChatGPT; exact 127.0.0.1 callback derives from BETTER_AUTH_URL.
# Defaults reuse the server Calendar encryption key ring. To use a separate ring,
# set BOTH CHATGPT_ENCRYPTION_KEYS (same JSON shape) and CHATGPT_ENCRYPTION_KEY_ID.
# Leave these absent to reuse the Calendar keys; blank values disable that fallback.
# CHATGPT_ENCRYPTION_KEYS=
# CHATGPT_ENCRYPTION_KEY_ID=
# Durable per-installation host ID, generated once with owner-only permissions:
# CHATGPT_HOST_FILE=.one-better/chatgpt-host.json
